{
    "name": "letterofmarque/marque",
    "description": "Modular BitTorrent tracker platform for Laravel",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Letter Of Marque Software",
            "email": "dan@lom.software",
            "homepage": "https://lom.software"
        }
    ],
    "support": {
        "issues": "https://github.com/letterofmarque/marque/issues",
        "source": "https://github.com/letterofmarque/marque"
    },
    "require": {
        "php": "^8.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.0"
    },
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test",
        "test": "for p in packages/*/; do (cd \"$p\" && composer test) || exit 1; done",
        "stan": "for p in packages/*/; do (cd \"$p\" && ../../vendor/bin/phpstan analyse --no-progress) || exit 1; done"
    }
}
