#!/usr/bin/env bash
#
# Tests for bin/release-preflight.
#
# Preflight is the stage that decides whether a release may start at all, so
# every one of its refusals is load-bearing: each one represents a way a
# release has gone wrong or could go wrong silently. A check that has never
# been seen to fire is not a check.
#
# Fixtures, and why they are shaped this way
# ------------------------------------------
# Most of these checks read real git state — the branch, the working tree,
# whether local matches origin. Testing them against the real repo would mean
# dirtying the tree and switching branches underneath whoever is running the
# tests, which is exactly the kind of thing that eats an afternoon when it goes
# wrong halfway through.
#
# So the destructive cases run against a throwaway clone in a temp directory,
# with its own origin, which can be dirtied and branch-switched freely and is
# deleted on exit. The read-only cases (semver shape, unknown package) run
# against the real repo because they cannot disturb it.
#
# Run: bin/test-release-preflight

set -uo pipefail

cd "$(dirname "$0")/.."
ROOT=$(pwd)
PREFLIGHT="$ROOT/bin/release-preflight"

PASS=0
FAIL=0

pass() { printf '  \033[32m✓\033[0m %s\n' "$1"; PASS=$((PASS + 1)); }
fail() {
    printf '  \033[31m✗\033[0m %s\n' "$1"
    [[ $# -gt 1 ]] && printf '      %s\n' "$2"
    FAIL=$((FAIL + 1))
}

# Same guard as bin/test-release-plan. Several assertions below are satisfied
# by a missing script — a refusal test cannot tell "refused" from "could not
# execute" — so without this the suite reports a partial green for a script
# that was never written.
if [[ ! -x "$PREFLIGHT" ]]; then
    printf '\n\033[31mbin/release-preflight does not exist or is not executable.\033[0m\n'
    printf 'Every assertion below would be testing its absence.\n'
    exit 1
fi

# ── the sandbox ──────────────────────────────────────────────────────────

SANDBOX=$(mktemp -d)
cleanup() { rm -rf "$SANDBOX"; }
trap cleanup EXIT INT TERM

# A clone with its OWN bare origin inside the sandbox.
#
# The origin must not be the real repo. These fixtures push, and a clone of
# $ROOT has $ROOT as its origin — so `git push origin main` would land test
# commits and test tags on the actual main branch. That is a genuinely nasty
# way to lose an afternoon, so the sandbox owns both ends: a bare origin it
# can push to freely, and a working clone of that.
#
# --no-hardlinks so nothing in here can reach back into the real object store.
setup_sandbox() {
    rm -rf "$SANDBOX/repo" "$SANDBOX/origin.git"
    git clone --quiet --bare --no-hardlinks "$ROOT" "$SANDBOX/origin.git" 2>/dev/null
    git clone --quiet --no-hardlinks "$SANDBOX/origin.git" "$SANDBOX/repo" 2>/dev/null
    git -C "$SANDBOX/repo" config user.email "test@example.com"
    git -C "$SANDBOX/repo" config user.name "Test"
    git -C "$SANDBOX/repo" checkout --quiet main 2>/dev/null
}

# Assert the sandbox really is isolated before anything pushes. If this is
# ever wrong, the tests below would write to the real repo — better to stop
# than to find out afterwards.
assert_sandbox_isolated() {
    local origin
    origin=$(git -C "$SANDBOX/repo" remote get-url origin 2>/dev/null)
    if [[ "$origin" != "$SANDBOX"* ]]; then
        printf '\n\033[31mSandbox origin is %s — refusing to run destructive fixtures.\033[0m\n' "$origin"
        exit 1
    fi
}

# Run the preflight inside the sandbox. A subshell so the cd cannot leak into
# the rest of the suite.
in_sandbox() {
    ( cd "$SANDBOX/repo" && "$PREFLIGHT" "$@" 2>&1 )
}

in_sandbox_rc() {
    ( cd "$SANDBOX/repo" && "$PREFLIGHT" "$@" >/dev/null 2>&1 )
}

# Assert a refusal is deliberate: non-zero exit AND a message that names the
# actual problem. "It exited non-zero" is too weak — a crash does that too, and
# a refusal nobody can read is a refusal that wastes somebody's afternoon.
refuses_with() {
    local desc="$1" pattern="$2"; shift 2
    local out rc
    out=$(in_sandbox "$@")
    rc=$?

    if [[ $rc -eq 0 ]]; then
        fail "$desc" "exited 0 — it should have refused"
    elif ! grep -qiE "$pattern" <<<"$out"; then
        fail "$desc" "refused, but the message did not match /$pattern/: $(head -2 <<<"$out")"
    else
        pass "$desc"
    fi
}

# ── the happy path ───────────────────────────────────────────────────────

printf '\n\033[1mA releasable tree passes\033[0m\n'

setup_sandbox
assert_sandbox_isolated

# guise 5.0.0 is already released, so 5.0.1 is the next legal patch and its
# changelog entry does not exist yet — add one so this case tests the git
# checks rather than the changelog check.
add_changelog_entry() {
    local pkg="$1" version="$2" summary="${3:-A test release.}"
    local file="$SANDBOX/repo/packages/$pkg/CHANGELOG.md"
    python3 - "$file" "$version" "$summary" <<'PY'
import sys
path, version, summary = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(path).read().split('\n')
for i, l in enumerate(lines):
    if l.startswith('## ['):
        entry = [f'## [{version}] — 2026-09-15', '', f'> {summary}', '', '### Changed', '', '- A change.', '']
        lines[i:i] = entry
        break
open(path, 'w').write('\n'.join(lines))
PY
}

add_changelog_entry guise 5.0.1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog for 5.0.1"
# The commit puts the clone ahead of its origin, which is a legitimate
# out-of-sync state. Push it so the tree under test is genuinely releasable.
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null

out=$(in_sandbox guise 5.0.1)
rc=$?

if [[ $rc -eq 0 ]]; then
    pass 'a clean, synced, changelogged release passes preflight'
else
    fail 'the happy path should pass' "rc=$rc: $(head -3 <<<"$out")"
fi

# ── git state ────────────────────────────────────────────────────────────

printf '\n\033[1mGit state must be releasable\033[0m\n'

setup_sandbox
add_changelog_entry guise 5.0.1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null
echo "scratch" > "$SANDBOX/repo/dirty-file.txt"
refuses_with 'a dirty working tree is refused' 'dirty|commit or stash' guise 5.0.1

setup_sandbox
git -C "$SANDBOX/repo" checkout --quiet -b not-main
refuses_with 'releasing off main is refused' 'main|branch' guise 5.0.1

setup_sandbox
add_changelog_entry guise 5.0.1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "unpushed commit"
# Committed but never pushed: local main is ahead of origin/main. This is the
# state that produced two of the four red commits in the 2026-09-11 incident,
# where bin/release pushed and then never re-verified.
refuses_with 'local main ahead of origin is refused' 'origin|sync|push or pull' guise 5.0.1

# ── changelog discipline ─────────────────────────────────────────────────

printf '\n\033[1mChangelog discipline\033[0m\n'

setup_sandbox
# No entry added at all for 5.0.1.
refuses_with 'a missing changelog entry is refused' 'changelog|entry' guise 5.0.1

setup_sandbox
# An entry with no '> summary' line under it. The root changelog is generated
# from that line, so without it tools/build-changelog produces a hole — and by
# then the tags are already pushed. Refused here, before anything is tagged.
python3 - "$SANDBOX/repo/packages/guise/CHANGELOG.md" <<'PY'
import sys
path = sys.argv[1]
lines = open(path).read().split('\n')
for i, l in enumerate(lines):
    if l.startswith('## ['):
        lines[i:i] = ['## [5.0.1] — 2026-09-15', '', '### Changed', '', '- No summary line above.', '']
        break
open(path, 'w').write('\n'.join(lines))
PY
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "entry without summary"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null
refuses_with "an entry with no '> summary' line is refused" 'summary' guise 5.0.1

# ── tags ─────────────────────────────────────────────────────────────────

printf '\n\033[1mTags must be free\033[0m\n'

setup_sandbox
add_changelog_entry guise 5.0.1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null
git -C "$SANDBOX/repo" tag "guise/v5.0.1"
refuses_with 'an existing local tag is refused' 'tag' guise 5.0.1

# The remote check is the one that matters and the one most easily forgotten:
# a tag can exist on origin while the local clone has never fetched it, and
# tagging over it fails at push time — after the earlier packages in the batch
# have already published.
setup_sandbox
add_changelog_entry guise 5.0.1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null
git -C "$SANDBOX/repo" tag "guise/v5.0.1"
git -C "$SANDBOX/repo" push --quiet origin "guise/v5.0.1" 2>/dev/null
git -C "$SANDBOX/repo" tag -d "guise/v5.0.1" >/dev/null 2>&1
refuses_with 'a tag that exists only on the remote is refused' 'tag' guise 5.0.1

# ── branch-alias is corrected, not refused ───────────────────────────────

printf '\n\033[1mbranch-alias is mechanical, so it is fixed\033[0m\n'

# Unlike the changelog (human-written prose, correctly refused rather than
# fabricated) the expected branch-alias is fully derivable: <major>.0.x-dev.
# So preflight corrects it and leaves the change in the tree for the caller to
# commit, rather than sending someone off to hand-edit JSON.
setup_sandbox
add_changelog_entry guise 6.0.0
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null

before=$(jq -r '.extra."branch-alias"."dev-main"' "$SANDBOX/repo/packages/guise/composer.json")
out=$(in_sandbox --allow-dirty guise 6.0.0)
after=$(jq -r '.extra."branch-alias"."dev-main"' "$SANDBOX/repo/packages/guise/composer.json")

if [[ "$after" == "6.0.x-dev" ]]; then
    pass "a stale branch-alias is corrected ($before -> $after)"
else
    fail 'branch-alias should have been synced to 6.0.x-dev' "got: $after"
fi

if grep -qiE 'branch-alias|dev-main' <<<"$out"; then
    pass 'the correction is reported, not silent'
else
    fail 'the branch-alias change should be announced' "got: $(head -3 <<<"$out")"
fi

# Correcting it must not be treated as a failure — it is the designed
# behaviour, and a non-zero exit here would stop a perfectly good release.
setup_sandbox
add_changelog_entry guise 6.0.0
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null
if in_sandbox_rc --allow-dirty guise 6.0.0; then
    pass 'syncing the alias still exits 0'
else
    fail 'a synced branch-alias should not fail preflight'
fi

# ── argument validation ──────────────────────────────────────────────────

printf '\n\033[1mArguments are validated\033[0m\n'

setup_sandbox

refuses_with 'a malformed version is refused' 'version|semver' guise 5.1
refuses_with 'a non-numeric version is refused' 'version|semver' guise banana
refuses_with 'an unknown package is refused' 'package|no such' nosuchpkg 1.0.0
refuses_with 'no arguments is refused' 'usage|package'
refuses_with 'an odd number of arguments is refused' 'version|usage|odd' guise 5.0.1 parley

# bin/release accepts pre-release suffixes (X.Y.Z-beta1) and this is an
# extraction that must not change behaviour, so preflight accepts them too.
#
# NOTE: bin/release-plan does NOT — it takes strict X.Y.Z only. That
# inconsistency is inherited, not introduced here, and is recorded in the
# CP #609 ledger rather than silently unified in an extraction checkpoint.
setup_sandbox
add_changelog_entry guise 5.0.1-beta1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null
if in_sandbox_rc --allow-dirty guise 5.0.1-beta1; then
    pass 'a pre-release version is accepted, as bin/release accepts it'
else
    fail 'X.Y.Z-beta1 should be accepted — bin/release accepts it'
fi

# ── multi-package ────────────────────────────────────────────────────────

printf '\n\033[1mSeveral packages in one preflight\033[0m\n'

setup_sandbox
add_changelog_entry guise 5.0.1
add_changelog_entry hound 3.2.1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md packages/hound/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelogs"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null

if in_sandbox_rc --allow-dirty guise 5.0.1 hound 3.2.1; then
    pass 'two packages both passing their checks is accepted'
else
    fail 'two valid packages should pass' "$(in_sandbox --allow-dirty guise 5.0.1 hound 3.2.1 | head -3)"
fi

# One good package must not carry a bad one through. Releases go out in
# batches, and a batch that half-passes is how you get a partially published
# set with no way back.
setup_sandbox
add_changelog_entry guise 5.0.1
git -C "$SANDBOX/repo" add packages/guise/CHANGELOG.md
git -C "$SANDBOX/repo" commit --quiet -m "changelog"
git -C "$SANDBOX/repo" push --quiet origin main 2>/dev/null
refuses_with 'a good package does not rescue a bad one' 'changelog|entry' \
    guise 5.0.1 hound 3.2.1

# ── ordering ─────────────────────────────────────────────────────────────

printf '\n\033[1mCheap checks run before expensive ones\033[0m\n'

# The whole point of preflight is that everything checkable is checked before
# any test or container work starts. A preflight that runs tests is not a
# preflight.
if ! grep -qE '^[^#]*(tools/test-engines|vendor/bin/pest|docker compose (up|run)|composer (update|install))' "$PREFLIGHT"; then
    pass 'preflight runs no tests and starts no containers'
else
    fail 'preflight should not run tests or containers' \
        "$(grep -nE '^[^#]*(tools/test-engines|vendor/bin/pest|docker compose (up|run))' "$PREFLIGHT" | head -3)"
fi

# It must also not tag or push — it is a check, not a release step.
if ! grep -qE '^[^#]*(git tag -a|git push|git commit)' "$PREFLIGHT"; then
    pass 'preflight does not tag, commit or push'
else
    fail 'preflight should not mutate git history' \
        "$(grep -nE '^[^#]*(git tag -a|git push|git commit)' "$PREFLIGHT" | head -3)"
fi

# ── summary ──────────────────────────────────────────────────────────────

echo
if [[ $FAIL -eq 0 ]]; then
    printf '\033[32m%d passed.\033[0m\n' "$PASS"
    exit 0
else
    printf '\033[31m%d passed, %d failed.\033[0m\n' "$PASS" "$FAIL"
    exit 1
fi
