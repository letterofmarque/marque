#!/usr/bin/env bash
#
# Everything about a release that can be checked before any work starts.
#
#   bin/release-preflight guise 5.0.1
#   bin/release-preflight guise 5.0.1 hound 3.2.1
#   bin/release-preflight --allow-dirty guise 5.0.1
#
# Extracted from bin/release stage 1, behaviour unchanged. The checks are the
# ones that have actually caught something, or that exist because something got
# through:
#
#   - clean tree, on main, in sync with origin/main
#   - a CHANGELOG.md entry for each version, WITH its `> summary` line
#   - the tag is free, locally AND on the remote
#   - extra.branch-alias.dev-main matches <major>.0.x-dev
#   - the version is valid semver and the package exists
#
# Why all of it runs first
# ------------------------
# Because the expensive half of a release is the test matrix, and discovering a
# missing changelog line after twenty minutes of containers is a waste that
# compounds: you fix it, commit, and start the twenty minutes again. Everything
# here is cheap and needs nothing running.
#
# The sharper reason is what happens when a check fires LATE. The root
# CHANGELOG.md is generated from the `> summary` lines, so a missing one breaks
# generation — and generation happens after tagging. A tag is public the moment
# it is pushed, and the 2026-09-11 release is the worked example of what a
# half-finished release costs: main red for four consecutive commits, two of
# them pushed by the release script itself.
#
# Refuse vs. fix
# --------------
# The changelog is human-written prose. If it is missing, the only honest thing
# is to stop and say so — fabricating a summary would put words in somebody's
# mouth in a file that ships to strangers.
#
# branch-alias is the opposite: <major>.0.x-dev is fully derivable from the
# version being released, nothing else maintains it, and it drifts silently.
# So it is corrected in place and left in the tree for the caller to commit,
# rather than sending someone off to hand-edit JSON to satisfy a machine that
# already knows the answer.
#
# This script checks and (for branch-alias) corrects. It does not tag, commit,
# push, or run a single test.

set -uo pipefail

# Operate on the repository we were INVOKED from, not the one this script
# lives in. Every other bin/ script cds to its own parent, which is right for
# them — they act on their own checkout. This one reads git state (branch,
# cleanliness, sync with origin), so pinning it to the script's location would
# mean a copy run from anywhere silently reports on the wrong repository.
#
# That is not hypothetical: it is exactly what the tests do, running the
# script against a throwaway clone. A preflight that checks a different tree
# than the one being released is worse than no preflight.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { printf '\033[31merror: not inside a git repository\033[0m\n' >&2; exit 1; }
cd "$ROOT"
PACKAGES_DIR="$ROOT/packages"

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
blue()  { printf '\033[34m%s\033[0m\n' "$*"; }
die()   { red "error: $*" >&2; exit 1; }

# The tree is dirty after a branch-alias sync, by design — the caller commits
# it. That makes a second preflight on the same release fail the clean-tree
# check for a reason the first one created. --allow-dirty is the escape hatch
# for that case and for tests; the release flow itself runs without it, so the
# check keeps its teeth where it matters.
ALLOW_DIRTY=false
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --allow-dirty) ALLOW_DIRTY=true; shift ;;
        -h|--help) sed -n '2,8p' "$0" | sed 's/^# \?//'; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) ARGS+=("$1"); shift ;;
    esac
done

if [[ ${#ARGS[@]} -eq 0 ]]; then
    echo "usage: bin/release-preflight [--allow-dirty] <package> <version> [<package> <version>...]" >&2
    exit 2
fi

if [[ $(( ${#ARGS[@]} % 2 )) -ne 0 ]]; then
    die "each package needs a version — got an odd number of arguments"
fi

# ── carried forward from bin/release, unchanged ──────────────────────────

# Accepts pre-release suffixes. NOTE: bin/release-plan takes strict X.Y.Z only,
# so a beta passes here and is refused there. That inconsistency is inherited
# from bin/release rather than introduced, and unifying it is a decision for
# the skill (CP #610), not something to change quietly inside an extraction.
validate_semver() {
    [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)[0-9]*)?$ ]] \
        || die "'$1' is not a valid version (expected X.Y.Z or X.Y.Z-beta1)"
}

tag_for() { printf '%s/v%s\n' "$1" "$2"; }

# Both halves matter. A tag can exist on origin while this clone has never
# fetched it — and then tagging "succeeds" locally and fails at push time,
# after the earlier packages in the batch have already published.
tag_already_exists() {
    git rev-parse -q --verify "refs/tags/$1" >/dev/null 2>&1 \
        || git ls-remote --tags origin "refs/tags/$1" 2>/dev/null | grep -q .
}

check_git_state() {
    blue "==> Preflight"

    if ! $ALLOW_DIRTY; then
        [[ -z "$(git status --porcelain)" ]] \
            || die "working tree is dirty — commit or stash first"
    fi

    local branch
    branch="$(git branch --show-current)"
    [[ "$branch" == "main" ]] \
        || die "on branch '$branch' — releases are cut from main"

    git fetch --quiet origin main
    local local_head remote_head
    local_head="$(git rev-parse HEAD)"
    remote_head="$(git rev-parse origin/main)"
    [[ "$local_head" == "$remote_head" ]] \
        || die "local main differs from origin/main — push or pull first"

    green "    clean tree, on main, in sync with origin"
}

check_changelog() {
    local pkg="$1" version="$2"
    local file="$PACKAGES_DIR/$pkg/CHANGELOG.md"

    [[ -f "$file" ]] \
        || die "$pkg has no CHANGELOG.md — add one before releasing (see packages/*/CHANGELOG.md for the format)"

    grep -qF "[$version]" "$file" \
        || die "$pkg/CHANGELOG.md has no entry for $version — add one and commit it before releasing"

    # The root CHANGELOG.md is generated from these entries and needs a
    # one-sentence summary per release. Checked here, with everything else that
    # must be written before we tag, rather than failing at generation time
    # once tags are already pushed.
    awk -v want="[$version]" '
        index($0, "## " want) == 1 { found = 1; next }
        found && /^> / { ok = 1; exit }
        found && (/^## \[/ || /^### /) { exit }
        END { exit ok ? 0 : 1 }
    ' "$file" \
        || die "$pkg/CHANGELOG.md has no '> summary' line under [$version] — add a one-sentence summary for the root changelog (see tools/build-changelog)"
}

# Returns 0 if it changed anything (caller commits), 1 if already correct.
# Note the inverted convention — it is bin/release's, kept so the extraction
# stays a move rather than a rewrite.
sync_branch_alias() {
    local pkg="$1" version="$2"
    local file="$PACKAGES_DIR/$pkg/composer.json"
    local major="${version%%.*}"
    local expected="${major}.0.x-dev"

    local current
    current="$(jq -r '.extra."branch-alias"."dev-main" // empty' "$file")"

    [[ "$current" == "$expected" ]] && return 1

    jq --indent 4 --arg alias "$expected" \
        '.extra."branch-alias"."dev-main" = $alias' \
        "$file" > "$file.tmp"
    mv "$file.tmp" "$file"

    echo "    $pkg: dev-main $current -> $expected"
    return 0
}

# ── run the checks ───────────────────────────────────────────────────────
#
# Argument validation first, because it needs no git at all and a typo should
# not cost a fetch. Then git state once for the whole batch. Then the
# per-package checks.

RELEASES=()

for (( i=0; i<${#ARGS[@]}; i+=2 )); do
    pkg="${ARGS[$i]}"
    ver="${ARGS[$((i+1))]}"

    [[ -d "$PACKAGES_DIR/$pkg" ]] || die "no such package: $pkg"
    validate_semver "$ver"

    RELEASES+=("$pkg $ver")
done

check_git_state

# Every package is checked before anything is reported as good. A batch that
# half-passes is how you get a partially published set, so one bad package
# stops the whole thing — the same reason bin/release validates up front.
blue "==> Changelogs"
for r in "${RELEASES[@]}"; do
    read -r pkg ver <<<"$r"
    check_changelog "$pkg" "$ver"
done
green "    every package has a CHANGELOG.md entry and a summary for its release version"

blue "==> Tags"
for r in "${RELEASES[@]}"; do
    read -r pkg ver <<<"$r"
    tag="$(tag_for "$pkg" "$ver")"
    if tag_already_exists "$tag"; then
        die "tag $tag already exists (locally or on origin) — bump the version or delete the tag"
    fi
done
green "    every tag is free, locally and on origin"

blue "==> branch-alias"
alias_changed=()
for r in "${RELEASES[@]}"; do
    read -r pkg ver <<<"$r"
    if sync_branch_alias "$pkg" "$ver"; then
        alias_changed+=("$pkg")
    fi
done

if [[ ${#alias_changed[@]} -gt 0 ]]; then
    green "    branch-alias synced for ${#alias_changed[@]} package(s) — commit before tagging"
else
    green "    branch-alias already correct for every package"
fi

echo
green "Preflight passed for: ${RELEASES[*]}"
