{
    "name": "marque/trove",
    "description": "Core models, services, and contracts for Marque tracker platform",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Letter Of Marque Software",
            "email": "dan@lom.software",
            "homepage": "https://lom.software"
        }
    ],
    "support": {
        "issues": "https://github.com/letterofmarque/marque/issues",
        "source": "https://github.com/letterofmarque/marque"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../threepio",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "marque/threepio": "^3.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "mockery/mockery": "^1.6",
        "nunomaduro/pao": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Marque\\Trove\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marque\\Trove\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "4.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Marque\\Trove\\TroveServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
