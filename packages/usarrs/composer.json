{
    "name": "marque/usarrs",
    "description": "Authentication, user profiles, invites, and admin for Marque",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Letter Of Marque Software",
            "email": "dan@lom.software",
            "homepage": "https://lom.software"
        }
    ],
    "support": {
        "issues": "https://github.com/letterofmarque/marque/issues",
        "source": "https://github.com/letterofmarque/marque"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../trove",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../threepio",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../ise",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "marque/trove": "^3.0",
        "marque/threepio": "^3.0",
        "marque/ise": "^1.0",
        "illuminate/support": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/view": "^13.0",
        "illuminate/auth": "^13.0",
        "illuminate/notifications": "^13.0",
        "livewire/livewire": "^4.0",
        "laravel/fortify": "^1.30"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "laravel/socialite": "Required for OAuth/socialite auth driver (^5.0)"
    },
    "autoload": {
        "psr-4": {
            "Marque\\Usarrs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marque\\Usarrs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Marque\\Usarrs\\UsarrsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
