{
    "name": "marque/guise",
    "description": "Livewire web frontend for Marque tracker platform",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Letter Of Marque Software",
            "email": "dan@lom.software",
            "homepage": "https://lom.software"
        }
    ],
    "support": {
        "issues": "https://github.com/letterofmarque/marque/issues",
        "source": "https://github.com/letterofmarque/marque"
    },
    "require": {
        "php": "^8.2",
        "marque/trove": "^1.0",
        "illuminate/support": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/view": "^12.0",
        "livewire/livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marque\\Guise\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marque\\Guise\\GuiseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
