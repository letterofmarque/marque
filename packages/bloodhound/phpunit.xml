<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Configurable announce routing (job #10649). One directory per URL
            shape, because routes register during the provider's boot() and the
            config therefore has to be set in defineEnvironment — which means a
            TestCase per configuration, and Pest binds one test case per
            directory. Leaving these out of the suite would skip them silently.
        -->
        <testsuite name="Routing">
            <directory>tests/RoutingPath</directory>
            <directory>tests/RoutingQuery</directory>
            <directory>tests/RoutingPattern</directory>
        </testsuite>
        <!-- Spec #118 CP3: one directory per ratio_mode; see tests/Pest.php. -->
        <testsuite name="Panels">
            <directory>tests/PanelsFull</directory>
            <directory>tests/PanelsOff</directory>
            <directory>tests/PanelsSeedtime</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="REDIS_CLIENT" value="phpredis"/>
    </php>
</phpunit>
