{
    "name": "marque/bosun",
    "description": "Staff management for Marque: the staff action log, staff presence, and the owner's Staff and Audit log screens",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "audit-log",
        "staff",
        "moderation",
        "tracker",
        "laravel"
    ],
    "authors": [
        {
            "name": "Letter Of Marque Software",
            "email": "dan@lom.software",
            "homepage": "https://lom.software"
        }
    ],
    "support": {
        "issues": "https://github.com/letterofmarque/marque/issues",
        "source": "https://github.com/letterofmarque/marque"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../trove",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../threepio",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../deck",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../usarrs",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "marque/trove": "^5.0",
        "marque/deck": "^2.2",
        "marque/usarrs": "^9.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/view": "^13.0",
        "illuminate/auth": "^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "mockery/mockery": "^1.6",
        "laravel/pao": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Marque\\Bosun\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marque\\Bosun\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Marque\\Bosun\\BosunServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
